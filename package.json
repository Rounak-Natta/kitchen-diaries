{
  "name": "kd-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical.config.ts",
    "test:db:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:db:migrate && npm run test:integration",
    "security:review": "dotenv -e .env -- tsx scripts/security-review.ts",
    "verify:ci": "npm run typecheck && npm run test:unit && npm run test:coverage:critical && npm run security:review",
    "verify:tests": "npm run typecheck && npm run test:unit && npm run test:coverage:critical && npm run test:db:migrate && npm run test:integration && npm run security:review",
    "env:check": "tsx scripts/check-environment.ts .env",
    "env:check:test": "tsx scripts/check-environment.ts .env.test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "npm run db:seed",
    "vercel-build": "prisma generate && next build",
    "db:seed:demo": "tsx prisma/seed.ts",
    "seed:demo": "npm run db:seed:demo",
    "db:setup:demo": "prisma migrate reset --force && npm run seed:demo",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:desktop": "tsx prisma/seed.ts",
    "seed:desktop": "npm run db:seed:desktop",
    "db:setup:desktop": "prisma migrate reset --force && npm run seed:desktop",
    "setup:desktop": "powershell -ExecutionPolicy Bypass -File scripts/setup-desktop.ps1",
    "db:setup:test": "docker compose up -d postgres-test && npm run test:db:migrate",
    "setup:test": "powershell -ExecutionPolicy Bypass -File scripts/setup-test-db.ps1",
    "db:setup:local": "prisma migrate reset --force && npm run seed:demo",
    "db:setup:production": "prisma migrate deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.11",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.4.4",
    "framer-motion": "^12.40.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
