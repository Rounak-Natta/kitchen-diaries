# Kitchen Diaries POS — copy to .env and replace every placeholder.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public"

# Use at least 32 cryptographically random characters. Never reuse the admin secret.
JWT_SECRET="replace-with-a-long-random-pos-secret-at-least-32-characters"

# Optional runtime settings.
PORT="3000"
HOSTNAME="0.0.0.0"
NEXT_TELEMETRY_DISABLED="1"
