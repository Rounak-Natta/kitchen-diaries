generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  OWNER
  MANAGER
  CASHIER
  STEWARD
  KITCHEN
  STORE_KEEPER
}

enum CategoryType {
  FOOD
  BEVERAGE
  DESSERT
  STARTER
  MAIN_COURSE
  SNACK
  COMBO
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
  VEGAN
  JAIN
}

enum MenuItemStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

enum SpiceLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  BILLED
  COMPLETED
  CANCELLED
}

enum KOTStatus {
  QUEUED
  PREPARING
  READY
  CANCELLED
}

enum SubscriptionPlan {
  BASIC
  PRO
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  BLOCKED
}

enum SyncOperationStatus {
  PENDING
  SYNCING
  PROCESSING
  RETRYING
  COMPLETED
  FAILED
  CONFLICT
}

enum ActivationCodeStatus {
  AVAILABLE
  USED
  REVOKED
  EXPIRED
}

enum InventoryStatus {
  NOT_DEDUCTED
  DEDUCTED
  PARTIALLY_RESTORED
  RESTORED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  BANK_TRANSFER
}

enum BillStatus {
  ACTIVE
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum DiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum InventoryItemType {
  RAW_MATERIAL
  FINISHED_PRODUCT
  PACKAGING
  CONSUMABLE
}

enum InventoryUnit {
  GRAM
  KILOGRAM
  MILLILITRE
  LITRE
  PIECE
  PACKET
  BOX
  BOTTLE
  CAN
  PORTION
}

enum InventoryMode {
  NONE
  RECIPE
  DIRECT
}

enum RecipeAdjustmentType {
  ADD
  REPLACE
  REMOVE
}

enum RecipeSource {
  BASE_RECIPE
  VARIATION
  ADDON
  DIRECT
}

enum InventoryTransactionType {
  OPENING_STOCK
  STOCK_IN
  STOCK_OUT
  SALE_CONSUMPTION
  WASTAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESTORE
  CUSTOMER_RETURN
  REVERSAL
}

enum WastageReason {
  EXPIRED
  SPOILED
  DAMAGED
  PREPARATION_LOSS
  COOKING_LOSS
  ORDER_CANCELLED
  STAFF_MEAL
  SPILLAGE
  OTHER
}

enum WastageStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DocumentType {
  ORDER
  BILL
  RECEIPT
  INVENTORY_TRANSACTION
  WASTAGE
  REFUND
  EXPORT
}

enum ExportType {
  ORDERS
  BILLS
  PAYMENTS
  SALES_REPORT
  INVENTORY
  INVENTORY_LEDGER
  RECIPES
  WASTAGE
  AUDIT_LOG
  FULL_DATA
}

enum ExportFormat {
  CSV
  XLSX
  PDF
  JSON
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

// ======================================================
// RESTAURANT / SETTINGS
// ======================================================

model Restaurant {
  id                   String   @id @default(cuid())
  name                 String
  email                String?  @unique
  phone                String?
  address              String?
  currency             String   @default("INR")
  timezone             String   @default("Asia/Kolkata")
  businessDayStartHour Int      @default(4)
  defaultTaxRate       Decimal  @default(5) @db.Decimal(5, 2)
  orderPrefix          String   @default("ORD")
  billPrefix           String   @default("BILL")
  receiptPrefix        String   @default("RCPT")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                 User[]
  categories            Category[]
  menuItems             MenuItem[]
  variationGroups       VariationGroup[]
  addons                Addon[]
  orders                Order[]
  kots                  KOT[]
  bills                 Bill[]
  inventoryCategories   InventoryCategory[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  recipes               Recipe[]
  wastages              Wastage[]
  auditLogs             AuditLog[]
  dataExports           DataExport[]
  businessSequences     BusinessSequence[]
  subscriptions         Subscription[]
  devices               Device[]
  syncOperations        SyncOperation[]
  activationCodes       ActivationCode[]
  notifications         Notification[]

  @@index([isActive])
}

// ======================================================
// USERS / RBAC
// ======================================================

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  role         Role       @default(STEWARD)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  ordersCreated         Order[]                @relation("OrdersCreatedBy")
  ordersCancelled       Order[]                @relation("OrdersCancelledBy")
  billsCreated          Bill[]                 @relation("BillsCreatedBy")
  billsCancelled        Bill[]                 @relation("BillsCancelledBy")
  paymentsRecorded      BillPayment[]          @relation("PaymentsRecordedBy")
  refundsCreated        BillRefund[]           @relation("RefundsCreatedBy")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionsCreatedBy")
  wastagesCreated       Wastage[]              @relation("WastagesCreatedBy")
  wastagesApproved      Wastage[]              @relation("WastagesApprovedBy")
  auditLogs             AuditLog[]
  dataExports           DataExport[]
  activatedDevices      Device[]               @relation("DeviceActivatedBy")
  notifications         Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, role])
  @@index([restaurantId, isActive])
}

// ======================================================
// SUBSCRIPTION MODULE
// ======================================================

model Subscription {
  id String @id @default(cuid())

  plan   SubscriptionPlan
  status SubscriptionStatus @default(ACTIVE)

  startsAt  DateTime
  expiresAt DateTime

  maxDevices Int @default(10)
  priceAmount Decimal? @db.Decimal(10, 2)
  currency String @default("INR")

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  renewedAt DateTime?
  renewalCount Int @default(0)
  previousExpiresAt DateTime?
  graceUntilAt DateTime?
  cancelledAt DateTime?
  cancelReason String?

  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([expiresAt])
  @@index([restaurantId, expiresAt])
}

// ======================================================
// DEVICE AUTH
// ======================================================

model Device {
  id String @id @default(cuid())

  deviceKeyHash String  @unique
  name          String?

  status DeviceStatus @default(ACTIVE)

  activatedAt DateTime?
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  activatedById String?
  activatedBy   User?   @relation("DeviceActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)

  syncOperations SyncOperation[]

  appVersion String?
  syncProtocolVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, lastSeenAt])
  @@index([restaurantId, appVersion])
}

model SyncOperation {
  id String @id @default(cuid())

  operationId String @unique

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  operationType String
  entityType    String
  entityId      String

  // Version of the entity when the client created
  // the offline operation.
  baseVersion Int?

  // Version assigned by the server after successful
  // processing.
  resultVersion Int?

  status SyncOperationStatus @default(PENDING)

  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  errorCode       String?
  retryCount      Int       @default(0)
  lastAttemptAt   DateTime?
  acknowledgedAt  DateTime?
  conflictCode    String?
  conflictPayload Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([restaurantId, createdAt])
  @@index([deviceId, createdAt])
  @@index([restaurantId, status])
  @@index([restaurantId, updatedAt, id])
  @@index([entityType, entityId])
  @@index([restaurantId, entityType, entityId])
}


model ActivationCode {
  id String @id @default(cuid())

  codeHash String @unique

  status ActivationCodeStatus @default(AVAILABLE)

  plan           SubscriptionPlan
  durationMonths Int
  maxDevices     Int @default(10)
  priceAmount    Decimal? @db.Decimal(10, 2)
  currency       String @default("INR")

  // Sales/onboarding metadata captured when the license is issued.
  // Keeping this on the activation code allows the control plane to know
  // who a code belongs to before the restaurant tenant exists.
  restaurantName String?
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  notes          String?

  expiresAt DateTime?
  usedAt    DateTime?

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([restaurantId])
  @@index([customerEmail])
}

// ======================================================
// MENU CATEGORIES
// ======================================================

model Category {
  id           String       @id @default(cuid())
  name         String
  slug         String
  description  String?
  type         CategoryType
  dietaryType  DietaryType
  isActive     Boolean      @default(true)
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive])
}

// ======================================================
// MENU ITEMS
// ======================================================

model MenuItem {
  id              String         @id @default(cuid())
  name            String
  slug            String
  description     String?
  shortCode       String?
  imageUrl        String?
  price           Decimal        @db.Decimal(10, 2)
  comparePrice    Decimal?       @db.Decimal(10, 2)
  costPrice       Decimal?       @db.Decimal(10, 2)
  taxRate         Decimal?       @db.Decimal(5, 2)
  isTaxInclusive  Boolean        @default(false)
  sku             String?
  barcode         String?
  preparationTime Int?
  calories        Int?
  status          MenuItemStatus @default(AVAILABLE)
  spiceLevel      SpiceLevel     @default(NONE)
  dietaryType     DietaryType
  inventoryMode   InventoryMode  @default(NONE)
  isFeatured      Boolean        @default(false)
  isRecommended   Boolean        @default(false)
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  directInventoryItemId String?
  directInventoryItem   InventoryItem? @relation("DirectInventoryItem", fields: [directInventoryItemId], references: [id], onDelete: SetNull)

  recipe     Recipe?
  variations MenuItemVariation[]
  addons     MenuItemAddon[]
  orderItems OrderItem[]
  billItems  BillItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, slug])
  @@index([restaurantId, sku])
  @@index([restaurantId, barcode])
  @@index([restaurantId, isActive])
  @@index([restaurantId, status])
  @@index([categoryId])
  @@index([directInventoryItemId])
}

// ======================================================
// VARIATIONS
// ======================================================

model VariationGroup {
  id           String     @id @default(cuid())
  name         String
  slug         String
  description  String?
  isActive     Boolean    @default(true)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  options   VariationOption[]
  menuItems MenuItemVariation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive])
}

model VariationOption {
  id               String         @id @default(cuid())
  name             String
  description      String?
  price            Decimal?       @db.Decimal(10, 2)
  sortOrder        Int            @default(0)
  isDefault        Boolean        @default(false)
  isActive         Boolean        @default(true)
  variationGroupId String
  variationGroup   VariationGroup @relation(fields: [variationGroupId], references: [id], onDelete: Cascade)

  orderItems        OrderItem[]
  recipeAdjustments VariationRecipeItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([variationGroupId, name])
  @@index([variationGroupId, isActive])
}

model MenuItemVariation {
  id               String @id @default(cuid())
  menuItemId       String
  variationGroupId String

  menuItem       MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variationGroup VariationGroup @relation(fields: [variationGroupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([menuItemId, variationGroupId])
  @@index([menuItemId])
  @@index([variationGroupId])
}

// ======================================================
// ADD-ONS
// ======================================================

model Addon {
  id           String     @id @default(cuid())
  name         String
  price        Decimal    @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems   MenuItemAddon[]
  orderItems  OrderItemAddon[]
  recipeItems AddonRecipeItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
}

model MenuItemAddon {
  id         String @id @default(cuid())
  menuItemId String
  addonId    String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addon    Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([menuItemId, addonId])
  @@index([menuItemId])
  @@index([addonId])
}

// ======================================================
// ORDERS
// ======================================================

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  idempotencyKey  String?
  orderType       OrderType       @default(DINE_IN)
  tableNumber     String?
  status          OrderStatus     @default(PENDING)
  inventoryStatus InventoryStatus @default(NOT_DEDUCTED)
  version         Int             @default(1)

  customerName    String?
  customerPhone   String?
  customerAddress String?

  subtotal        Decimal      @db.Decimal(10, 2)
  taxRate         Decimal      @default(0) @db.Decimal(5, 2)
  tax             Decimal      @db.Decimal(10, 2)
  discountType    DiscountType @default(NONE)
  discountValue   Decimal      @default(0) @db.Decimal(10, 2)
  discount        Decimal      @default(0) @db.Decimal(10, 2)
  discountReason  String?
  serviceCharge   Decimal      @default(0) @db.Decimal(10, 2)
  deliveryCharge  Decimal      @default(0) @db.Decimal(10, 2)
  packagingCharge Decimal      @default(0) @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  notes           String?

  businessDate        DateTime? @db.Date
  confirmedAt         DateTime?
  preparingAt         DateTime?
  readyAt             DateTime?
  billedAt            DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  inventoryDeductedAt DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("OrdersCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  cancelledById String?
  cancelledBy   User?   @relation("OrdersCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  items                 OrderItem[]
  kots                  KOT[]
  bill                  Bill?
  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, orderType, createdAt])
  @@index([createdById, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  itemName       String
  basePrice      Decimal @db.Decimal(10, 2)
  variationPrice Decimal @default(0) @db.Decimal(10, 2)
  addonPrice     Decimal @default(0) @db.Decimal(10, 2)
  totalPrice     Decimal @db.Decimal(10, 2)
  notes          String?

  variationOptionId String?
  variationOption   VariationOption? @relation(fields: [variationOptionId], references: [id], onDelete: SetNull)

  addons   OrderItemAddon[]
  billItem BillItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
  @@index([variationOptionId])
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonId     String
  addon       Addon     @relation(fields: [addonId], references: [id], onDelete: Restrict)

  price Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([addonId])
}

// ======================================================
// KITCHEN ORDER TICKETS
// ======================================================

model KOT {
  id           String    @id @default(cuid())
  kotNumber    String
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber  String?
  status       KOTStatus @default(QUEUED)
  notes        String?
  printedAt    DateTime?
  reprintCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items KOTItem[]

  @@unique([restaurantId, kotNumber])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([orderId])
}

model KOTItem {
  id                String @id @default(cuid())
  kotId             String
  kot               KOT    @relation(fields: [kotId], references: [id], onDelete: Cascade)
  menuItemId        String?
  itemName          String
  quantity          Int
  variationOptionId String?
  addonIds          String[]
  notes             String?
  createdAt         DateTime @default(now())

  @@index([kotId])
  @@index([menuItemId])
}

// ======================================================
// BILLING
// ======================================================


model Bill {
  id             String     @id @default(cuid())
  billNumber     String     @unique
  receiptNumber  String?    @unique
  idempotencyKey String?
  status         BillStatus @default(ACTIVE)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("BillsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  cancelledById String?
  cancelledBy   User?   @relation("BillsCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  orderType   OrderType
  tableNumber String?

  customerName    String?
  customerPhone   String?
  customerAddress String?

  subtotal           Decimal       @db.Decimal(10, 2)
  taxRate            Decimal       @default(0) @db.Decimal(5, 2)
  tax                Decimal       @db.Decimal(10, 2)
  discountType       DiscountType  @default(NONE)
  discountValue      Decimal       @default(0) @db.Decimal(10, 2)
  discount           Decimal       @default(0) @db.Decimal(10, 2)
  discountReason     String?
  serviceCharge      Decimal       @default(0) @db.Decimal(10, 2)
  deliveryCharge     Decimal       @default(0) @db.Decimal(10, 2)
  packagingCharge    Decimal       @default(0) @db.Decimal(10, 2)
  roundOff           Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal         Decimal       @db.Decimal(10, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(10, 2)
  refundedAmount     Decimal       @default(0) @db.Decimal(10, 2)
  changeReturned     Decimal       @default(0) @db.Decimal(10, 2)
  dueAmount          Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus      PaymentStatus @default(PENDING)
  businessDate       DateTime?     @db.Date
  paidAt             DateTime?
  inventoryPostedAt  DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  notes              String?

  items                 BillItem[]
  payments              BillPayment[]
  refunds               BillRefund[]
  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, paymentStatus, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([orderId])
}

model BillItem {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  itemName       String
  categoryName   String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  addonPrice     Decimal  @default(0) @db.Decimal(10, 2)
  variationPrice Decimal  @default(0) @db.Decimal(10, 2)
  grossAmount    Decimal  @default(0) @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(10, 2)
  netSales       Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)
  costAmount     Decimal  @default(0) @db.Decimal(10, 2)
  grossProfit    Decimal  @default(0) @db.Decimal(10, 2)
  grossMarginPct Decimal  @default(0) @db.Decimal(7, 2)
  notes          String?
  variationName  String?
  addonNames     String[]

  ingredientSnapshots   BillItemIngredient[]
  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())

  @@index([billId])
  @@index([menuItemId])
}

model BillItemIngredient {
  id                     String                @id @default(cuid())
  billItemId             String
  billItem               BillItem              @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  inventoryItemId        String
  inventoryItem          InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryTransactionId String?               @unique
  inventoryTransaction   InventoryTransaction? @relation(fields: [inventoryTransactionId], references: [id], onDelete: SetNull)

  sourceType        RecipeSource
  sourceName        String?
  inventoryItemName String
  quantity          Decimal       @db.Decimal(14, 3)
  unit              InventoryUnit
  unitCost          Decimal       @db.Decimal(14, 4)
  totalCost         Decimal       @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([billItemId])
  @@index([inventoryItemId])
}

model BillPayment {
  id             String  @id @default(cuid())
  billId         String
  bill           Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  idempotencyKey String?

  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  tenderedAmount Decimal?      @db.Decimal(10, 2)
  referenceNo    String?
  notes          String?

  recordedById String?
  recordedBy   User?   @relation("PaymentsRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([billId, idempotencyKey])
  @@index([billId, createdAt])
  @@index([method, createdAt])
  @@index([recordedById, createdAt])
}

model BillRefund {
  id             String  @id @default(cuid())
  refundNumber   String  @unique
  billId         String
  bill           Bill    @relation(fields: [billId], references: [id], onDelete: Restrict)
  idempotencyKey String?

  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  reason      String
  referenceNo String?
  notes       String?

  createdById String
  createdBy   User   @relation("RefundsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([billId, idempotencyKey])
  @@index([billId, createdAt])
  @@index([createdById, createdAt])
}

// ======================================================
// INVENTORY
// ======================================================

model InventoryCategory {
  id           String     @id @default(cuid())
  name         String
  slug         String
  description  String?
  isActive     Boolean    @default(true)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  items InventoryItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive])
}

model InventoryItem {
  id                 String            @id @default(cuid())
  name               String
  code               String
  barcode            String?
  description        String?
  type               InventoryItemType
  unit               InventoryUnit
  currentStock       Decimal           @default(0) @db.Decimal(14, 3)
  minimumStock       Decimal           @default(0) @db.Decimal(14, 3)
  reorderLevel       Decimal           @default(0) @db.Decimal(14, 3)
  averageCost        Decimal           @default(0) @db.Decimal(14, 4)
  allowNegativeStock Boolean           @default(false)
  isActive           Boolean           @default(true)
  notes              String?

  categoryId String?
  category   InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  directMenuItems         MenuItem[]             @relation("DirectInventoryItem")
  recipeItems             RecipeItem[]
  variationRecipeItems    VariationRecipeItem[]
  addonRecipeItems        AddonRecipeItem[]
  transactions            InventoryTransaction[]
  wastageItems            WastageItem[]
  billIngredientSnapshots BillItemIngredient[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, code])
  @@unique([restaurantId, barcode])
  @@index([restaurantId, isActive])
  @@index([restaurantId, type])
  @@index([restaurantId, currentStock])
  @@index([categoryId])
}

model InventoryTransaction {
  id                String                   @id @default(cuid())
  transactionNumber String                   @unique
  idempotencyKey    String?
  type              InventoryTransactionType
  quantityChange    Decimal                  @db.Decimal(14, 3)
  stockBefore       Decimal                  @db.Decimal(14, 3)
  stockAfter        Decimal                  @db.Decimal(14, 3)
  unit              InventoryUnit
  unitCost          Decimal                  @default(0) @db.Decimal(14, 4)
  totalCost         Decimal                  @default(0) @db.Decimal(14, 2)
  reason            String?
  referenceType     String?
  referenceId       String?
  businessDate      DateTime?                @db.Date

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("InventoryTransactionsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  billId String?
  bill   Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)

  billItemId String?
  billItem   BillItem? @relation(fields: [billItemId], references: [id], onDelete: SetNull)

  billItemIngredient BillItemIngredient?
  wastageItem        WastageItem?

  createdAt DateTime @default(now())

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, type, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([orderId])
  @@index([billId])
  @@index([billItemId])
}

// ======================================================
// RECIPES
// ======================================================

model Recipe {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  notes       String?

  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  items RecipeItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([restaurantId, isActive])
}

model RecipeItem {
  id              String        @id @default(cuid())
  recipeId        String
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  quantity       Decimal       @db.Decimal(14, 3)
  unit           InventoryUnit
  wastagePercent Decimal       @default(0) @db.Decimal(5, 2)
  sortOrder      Int           @default(0)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, inventoryItemId])
  @@index([inventoryItemId])
}

model VariationRecipeItem {
  id                String          @id @default(cuid())
  variationOptionId String
  variationOption   VariationOption @relation(fields: [variationOptionId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  adjustmentType RecipeAdjustmentType @default(ADD)
  quantity       Decimal              @default(0) @db.Decimal(14, 3)
  unit           InventoryUnit
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variationOptionId, inventoryItemId])
  @@index([inventoryItemId])
}

model AddonRecipeItem {
  id              String        @id @default(cuid())
  addonId         String
  addon           Addon         @relation(fields: [addonId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  quantity Decimal       @db.Decimal(14, 3)
  unit     InventoryUnit
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([addonId, inventoryItemId])
  @@index([inventoryItemId])
}

// ======================================================
// WASTAGE
// ======================================================

model Wastage {
  id                 String        @id @default(cuid())
  wastageNumber      String        @unique
  status             WastageStatus @default(DRAFT)
  businessDate       DateTime?     @db.Date
  totalCost          Decimal       @default(0) @db.Decimal(14, 2)
  notes              String?
  postedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("WastagesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?   @relation("WastagesApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  items WastageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, createdAt])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, status, createdAt])
}

model WastageItem {
  id                     String                @id @default(cuid())
  wastageId              String
  wastage                Wastage               @relation(fields: [wastageId], references: [id], onDelete: Cascade)
  inventoryItemId        String
  inventoryItem          InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryTransactionId String?               @unique
  inventoryTransaction   InventoryTransaction? @relation(fields: [inventoryTransactionId], references: [id], onDelete: SetNull)

  quantity  Decimal       @db.Decimal(14, 3)
  unit      InventoryUnit
  unitCost  Decimal       @db.Decimal(14, 4)
  totalCost Decimal       @db.Decimal(14, 2)
  reason    WastageReason
  notes     String?

  createdAt DateTime @default(now())

  @@index([wastageId])
  @@index([inventoryItemId])
  @@index([reason])
}

// ======================================================
// AUDIT LOGS
// ======================================================

model AuditLog {
  id         String   @id @default(cuid())
  module     String
  action     String
  entityType String?
  entityId   String?
  oldData    Json?
  newData    Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, module, createdAt])
  @@index([restaurantId, action, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ======================================================
// DATA EXPORTS
// ======================================================

model DataExport {
  id           String       @id @default(cuid())
  exportNumber String       @unique
  type         ExportType
  format       ExportFormat
  status       ExportStatus @default(PENDING)
  filters      Json?
  fileName     String?
  fileUrl      String?
  errorMessage String?
  expiresAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([requestedById, createdAt])
}

// ======================================================
// SAFE DOCUMENT NUMBERING
// ======================================================

model BusinessSequence {
  id           String       @id @default(cuid())
  documentType DocumentType
  businessDate DateTime     @db.Date
  lastValue    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, documentType, businessDate])
  @@index([restaurantId, businessDate])
}


// ======================================================
// NOTIFICATIONS
// ======================================================

model Notification {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  orderId    String?
  orderNumber String?
  status     String?
  dedupeKey  String
  severity   String @default("INFO")
  priority   Int @default(0)
  actionUrl  String?
  expiresAt  DateTime?
  archivedAt DateTime?
  readAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dedupeKey])
  @@index([restaurantId, userId, createdAt])
  @@index([restaurantId, userId, readAt, createdAt])
  @@index([restaurantId, userId, severity, createdAt])
  @@index([restaurantId, entityType, entityId])
  @@index([expiresAt])
}

// ======================================================
// CONTROL PLANE / OBSERVABILITY
// ======================================================

model ControlAdmin {
  id String @id @default(cuid())
  name String
  email String @unique
  password String
  isActive Boolean @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemEvent {
  id String @id @default(cuid())
  severity String @default("INFO")
  source String
  message String
  requestId String?
  restaurantId String?
  deviceId String?
  metadata Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([severity, createdAt])
  @@index([restaurantId, createdAt])
  @@index([deviceId, createdAt])
}
